# Copy to .env and fill after `shopify app config link`
# Local dev with docker compose: docker compose up -d db (from repo root)

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Fly Custom-distribution client (88c56d21…) → leave unset / SingleMerchant (default).
# Public App Store client (bbaee078…) → MCFLY_APP_DISTRIBUTION=app_store
# MCFLY_APP_DISTRIBUTION=app_store
SHOPIFY_APP_URL=
SCOPES=read_orders,read_customers,read_all_orders
SHOPIFY_APP_URL=
DATABASE_URL=postgresql://mcfly:mcfly@localhost:5432/mcfly

# Optional
# NODE_ENV=development
# PORT=3000
# SHOP_CUSTOM_DOMAIN=

# ---------------------------------------------------------------------------
# Phase 2 — connected Meta/Google spend (amounts only; no pixels/attribution)
# Free path stays CSV paste on Spend; do not claim automatic spend on Free.
# Meta/Google App Review + developer token remain HUMAN GATES (not claimed done).
# ---------------------------------------------------------------------------
#
# Scaffold UI (Connections):
#   MCFLY_SPEND_OAUTH=1
# Optional deterministic mock when live tokens absent:
#   MCFLY_SPEND_OAUTH_MOCK=1
#
# Overnight worker live pulls (also need credentials below):
#   MCFLY_LIVE_META=1
#   MCFLY_LIVE_GOOGLE=1
#
# Meta Marketing API (Insights) — LIVE when tokens set + useMock false:
#   META_ACCESS_TOKEN=
#   META_AD_ACCOUNT_ID=          # act_XXX or numeric (normalized to act_)
#
# Google Ads API (GAQL cost_micros) — needs OAuth client + refresh + Ads token:
#   GOOGLE_ADS_DEVELOPER_TOKEN=
#   GOOGLE_ADS_CUSTOMER_ID=      # dashes optional
#   GOOGLE_ADS_REFRESH_TOKEN=
#   GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_SECRET=
# Optional MCC / manager account:
#   GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# MCFLY_SPEND_OAUTH=1
# MCFLY_SPEND_OAUTH_MOCK=1
# MCFLY_LIVE_META=1
# MCFLY_LIVE_GOOGLE=1
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# Order webhooks + Postgres job queue (docs/ops/JOB_QUEUE.md)
# Shared ops secret for POST /api/jobs/tick, which drains the dirty-day queue.
# The endpoint returns 404 while this is unset, so the queue simply accumulates.
# Not an ApiToken: a tick spans all shops, ApiToken is per-shop by design.
# MCFLY_JOBS_TICK_SECRET=
#
# Runner only (app/scripts/queue-worker.mjs). On Fly, process group `worker` runs this.
# Falls back to SHOPIFY_APP_URL when MCFLY_APP_URL is unset.
#   MCFLY_APP_URL=https://mcfly-analytics.fly.dev
#   MCFLY_QUEUE_INTERVAL_MS=15000
#   MCFLY_QUEUE_ONCE=1
# ---------------------------------------------------------------------------

# Pro Billing scaffold ($39 flat at launch). Default OFF — listing stays Free until announce.
# Feature gates (Meta+Google Free; LTV/all channels = Pro) are ON regardless.
# MCFLY_BILLING=1
# MCFLY_FREE_SPEND_IMPORT_CAP=20
# Design-partner / QA Pro override (comma *.myshopify.com):
# MCFLY_PRO_SHOPS=devmcflyads.myshopify.com

# ---------------------------------------------------------------------------
# Public API (/v1/mer, /v1/allocation, /v1/spend) — prefer per-shop ApiToken
# (mint via app/scripts/mint-api-token.mjs). Global env token is OFF by default.
# ---------------------------------------------------------------------------
# MCFLY_API_TOKEN=                 # optional ops global Bearer; disabled unless below
# MCFLY_ALLOW_GLOBAL_API_TOKEN=1   # explicit opt-in (still requires X-Mcfly-Shop-Id)
# MCFLY_API_OPS_SECRET=            # alt: require X-Mcfly-Ops-Secret header + shop id
#                                  # (no need for ALLOW_GLOBAL when ops secret matches)

