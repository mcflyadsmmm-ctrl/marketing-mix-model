// Mcfly Analytics — Prisma schema (Truth MVP)
// Production: PostgreSQL. Local: docker compose up -d db
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify OAuth session storage (required by @shopify/shopify-app-session-storage-prisma)
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id           String        @id @default(cuid())
  domain       String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  settings     Settings?
  spendEntries SpendEntry[]
  apiTokens    ApiToken[]
  syncRuns     SyncRun[]
  merSnapshots MerSnapshot[]
}

model Settings {
  id         String   @id @default(cuid())
  shopId     String   @unique
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  marginPct  Float    @default(0.35)
  targetMer  Float    @default(3.0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

enum SpendChannel {
  meta
  google
  other
}

model SpendEntry {
  id          String       @id @default(cuid())
  shopId      String
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  channel     SpendChannel
  amount      Float
  periodStart DateTime
  periodEnd   DateTime
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([shopId, periodStart, periodEnd])
}

/// Bearer tokens for Sheets companion + external API clients.
model ApiToken {
  id         String    @id @default(cuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  label      String    @default("default")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([shopId])
}

/// Overnight / scheduled orchestrator run ledger (one row per phase).
model SyncRun {
  id         String    @id @default(cuid())
  runId      String
  shopId     String?
  shop       Shop?     @relation(fields: [shopId], references: [id], onDelete: SetNull)
  phase      String
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  metrics    Json?
  errors     Json?

  @@index([runId])
  @@index([shopId, startedAt])
}

/// Daily MER snapshots for recon, Sheets history, and kill-criteria monitoring.
model MerSnapshot {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  sales        Float
  spend        Float
  mer          Float?
  breakEvenMer Float
  channelMix   Json
  allocation   Json?
  reconStatus  String   @default("pending")
  reconDelta   Float?
  createdAt    DateTime @default(now())

  @@unique([shopId, periodStart, periodEnd])
  @@index([shopId, createdAt])
}
