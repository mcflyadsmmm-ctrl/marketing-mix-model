{
  "name": "@mcfly/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Overnight orchestrator — phased MER sync, recon, snapshot, and kill-criteria reporting",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
