    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mcfly/connectors": "*",
    "@mcfly/mer-core": "*",
    "@mcfly/mer-engine": "*"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
