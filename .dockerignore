# Keep Fly/Depot build context small (avoid uploading local node_modules/.git)
.git
.gitignore
**/node_modules
**/dist
**/build
**/.react-router
**/.cache
**/.turbo
agent-logs
# `site/` is copied into the Fly image and served on public listing URLs.
docs
*.md
!app/README.md
.cursor
.vscode
.env
.env.*
!**/.env.example
fly.toml.bak
**/*.log
**/coverage
tmp
.DS_Store
