# Keep Fly/Depot build context small (avoid uploading local node_modules/.git)
.git
.gitignore
**/node_modules
**/dist
**/build
**/.react-router
**/.cache
**/.turbo
agent-logs
site
docs
*.md
!app/README.md
.cursor
.vscode
.env
.env.*
!**/.env.example
fly.toml.bak
**/*.log
**/coverage
tmp
.DS_Store
# Finder "Duplicate" copies (e.g. faq 2.tsx) break React Router / Fly builds
**/* 2.*
